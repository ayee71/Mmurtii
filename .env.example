# ==============================================================================
# SEERAAI PRO - ENVIRONMENT & AI STUDIO SETTINGS -> SECRETS TEMPLATE
# Never put real private keys or tokens in Git. Add private secrets in
# AI Studio "Settings -> Secrets" (or local .env, which is gitignored).
# ==============================================================================

# 1. AI Model Providers (Server-side proxy only)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_optional_openai_api_key

# 2. Telegram Bot & Serverless Webhook Configuration (Server-side only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://your-service-domain.run.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_random_alphanumeric_secret_32chars
TELEGRAM_SETUP_SECRET=replace_with_random_admin_setup_secret
TELEGRAM_SERVERLESS_TOKEN=replace_with_random_serverless_token
MINIAPP_BRIDGE_SECRET=replace_with_random_miniapp_bridge_secret

# 3. Firebase Configuration (Client falls back to firebase-applet-config.json automatically)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_ID=your_firestore_database_id
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id


