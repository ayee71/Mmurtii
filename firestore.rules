rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function signInProvider() {
      return request.auth.token.get(['firebase', 'sign_in_provider'], '');
    }

    function isNonAnonymous() {
      return isSignedIn() &&
        signInProvider() is string &&
        signInProvider() != '' &&
        signInProvider() != 'anonymous';
    }

    // Strict email verification check: never treats phone or anonymous auth as verified email
    function isEmailVerified() {
      return isNonAnonymous() &&
        request.auth.token.get('email_verified', false) == true &&
        signInProvider() != 'phone';
    }

    function isOwner(userId) {
      return isNonAnonymous() && request.auth.uid == userId;
    }

    // Verified claim-based or verified runtime-bootstrapped owner administrator check (Starter Tier safe)
    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'superadmin' ||
        request.auth.token.get('email', '') == 'ayeledha@gmail.com'
      );
    }

    function effectiveCourtRole() {
      return request.auth.token.get('courtRole', '') is string &&
        request.auth.token.get('courtRole', '') != ''
        ? request.auth.token.get('courtRole', '')
        : (request.auth.token.get('role', '') is string ? request.auth.token.get('role', '') : '');
    }

    function isLegalRepositoryManager() {
      return isEmailVerified() && (
        isAdmin() ||
        request.auth.token.get('legalContentManager', false) == true ||
        effectiveCourtRole() in ['judge', 'legal_expert', 'court_admin']
      );
    }

    // Option C narrow policy: legislation_repository create/update restricted to verified admins,
    // explicit legalContentManager claim holders, or verified institutional legal_expert staff.
    function canManageLegislationRepository() {
      return isAdmin() || (
        isEmailVerified() && (
          request.auth.token.get('legalContentManager', false) == true ||
          (hasInstitution() && effectiveCourtRole() == 'legal_expert')
        )
      );
    }

    function hasInstitution() {
      return isEmailVerified() &&
        request.auth.token.get('institutionId', '') is string &&
        request.auth.token.get('institutionId', '').size() > 0 &&
        request.auth.token.get('institutionId', '').size() <= 128;
    }

    function belongsToInstitution(institutionId) {
      return hasInstitution() && request.auth.token.get('institutionId', '') == institutionId;
    }

    function hasCourtRole() {
      return isEmailVerified() && (
        isAdmin() ||
        (hasInstitution() && effectiveCourtRole() in [
          'judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor', 'court_admin', 'clerk'
        ])
      );
    }

    function isInstitutionStaff(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() in [
          'judge', 'assistant_judge', 'registrar', 'legal_expert', 'auditor', 'court_admin', 'clerk'
        ]
      );
    }

    function isCourtAdminOf(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() == 'court_admin'
      );
    }

    function canEditCasesIn(institutionId) {
      return isAdmin() || (
        belongsToInstitution(institutionId) &&
        effectiveCourtRole() in ['judge', 'assistant_judge', 'registrar', 'court_admin']
      );
    }

    function canEditCases() {
      return hasCourtRole() && effectiveCourtRole() in ['judge', 'assistant_judge', 'registrar', 'court_admin'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidOptionalDataUrl(data) {
      return data.get('dataUrl', null) == null || (
        data.get('dataUrl', null) is string &&
        data.get('dataUrl', '').toUtf8().size() <= 65536
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Username Registry Protection
    match /usernameIndex/{username} {
      allow read: if isNonAnonymous();
      allow write: if false;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'visitorName', 'courtId']) &&
             data.keys().hasOnly(['uid', 'email', 'visitorName', 'courtId', 'createdAt', 'updatedAt', 'phone', 'photoURL', 'role', 'subscriptionTier', 'languagePreference']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.visitorName is string && data.visitorName.size() <= 100 &&
             data.courtId is string && data.courtId.size() <= 64;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'planId', 'amountETB', 'transactionReference', 'status', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'planId', 'amountETB', 'transactionReference', 'status', 'createdAt', 'payerPhone', 'payerName', 'notes', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'completed', 'rejected'] &&
             data.amountETB is number;
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().uid == userId &&
        !incoming().keys().hasAny(['role', 'admin', 'courtRole', 'institutionId']);
      allow update: if (isOwner(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'admin', 'courtRole', 'institutionId'])) ||
        isAdmin();
      
      match /webauthn_credentials/{credId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /legislation_repository/{id} {
      allow read: if true;
      allow create, update: if canManageLegislationRepository();
      allow delete: if isAdmin();
    }

    match /legalEnactments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cassationDecisions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legalAuditLogs/{id} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // TIGHTENED TELEGRAM COLLECTIONS (Phase 8B.5.3)
    // ==========================================
    match /telegram_legal_documents/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isLegalRepositoryManager();
    }
    match /telegram_posts/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isLegalRepositoryManager();
    }
    match /telegram_archive/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isLegalRepositoryManager();
    }
    match /telegram_channel_feed/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isLegalRepositoryManager();
    }
    match /telegram_polls/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /telegram_channels/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /telegram_messages/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /telegram_subscribers/{docId} {
      allow read, write: if isAdmin();
    }
    match /telegram_user_stats/{docId} {
      allow read, write: if isAdmin();
    }
    match /telegram_poll_results/{docId} {
      allow read, write: if isAdmin();
    }
    match /telegram_briefing_logs/{docId} {
      allow read, write: if isAdmin();
    }
    match /telegram_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /site_analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }
    match /legal_ai_audit/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /quality_audits/{auditId} {
      allow read: if isEmailVerified();
      allow create: if isEmailVerified() && (isAdmin() || effectiveCourtRole() in ['chief_judge', 'it_auditor', 'legal_expert', 'auditor']);
      allow update: if isEmailVerified() && (isAdmin() || effectiveCourtRole() in ['chief_judge', 'it_auditor', 'legal_expert', 'auditor']);
      allow delete: if isAdmin();
      
      match /{allPaths=**} {
        allow read, write: if isEmailVerified() && (isAdmin() || effectiveCourtRole() in ['chief_judge', 'it_auditor', 'legal_expert', 'auditor']);
      }
    }

    match /legal_sources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legalDocuments/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasCourtRole();
      
      match /textChunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin() || hasCourtRole();
      }
      
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isAdmin() || hasCourtRole();
      }

      match /reviewHistory/{reviewId} {
        allow read: if true;
        allow write: if isAdmin() || hasCourtRole();
      }
    }

    match /cassation_decisions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /witness_schedules/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || hasCourtRole() || isAdmin());
      allow create, update, delete: if hasCourtRole() || isAdmin();
    }

    match /vector_chunks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legal_qna_repository/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /social_legal_repository/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /objection_templates/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isEmailVerified() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /court_sessions/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update: if isEmailVerified() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /annotations/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /document_drafts/{id} {
      allow read: if resource.data.isPublic == true || (isEmailVerified() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isEmailVerified() && (incoming().userId == request.auth.uid || incoming().ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isEmailVerified() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid || isAdmin());
    }

    match /user_documents/{id} {
      allow get, list: if isEmailVerified() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && (incoming().userId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isEmailVerified() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid) && (incoming().userId == existing().userId || incoming().ownerId == existing().ownerId);
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || existing().ownerId == request.auth.uid || isAdmin());
    }

    match /shared_drafts/{id} {
      allow read: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || (resource.data.sharedWith != null && request.auth.uid in resource.data.sharedWith) || isAdmin());
      allow create: if isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isEmailVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /shared_folders/{id} {
      allow read: if isEmailVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isEmailVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /discussions/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isNonAnonymous() && (
        existing().authorId == request.auth.uid || 
        existing().userId == request.auth.uid || 
        existing().ownerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /dossier_audits/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
    }

    match /feedback_messages/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /analytics_events/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /payment_transactions/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidPayment(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /airtime_requests/{id} {
      allow read: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
    }

    match /audit_logs/{id} {
      allow read: if isAdmin() || (isNonAnonymous() && resource.data.userId == request.auth.uid);
      allow create: if isNonAnonymous() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /admin_activity_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_activity_logs_archived/{id} {
      allow read, write: if isAdmin();
    }

    match /auth_logs/{id} {
      allow read: if isAdmin() || (isNonAnonymous() && resource.data.userId == request.auth.uid);
      allow create: if isNonAnonymous() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /system_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidSystemSetting(data, settingId) {
      return data.keys().hasAll(['settingId', 'telegramWebhookUrl', 'updatedBy', 'updatedByEmail', 'updatedAt']) &&
             data.keys().hasOnly([
               'settingId', 'telegramWebhookUrl', 'updatedBy', 'updatedByEmail',
               'updatedAt', 'lastValidationStatus', 'lastValidatedAt', 'lastValidationMessage'
             ]) &&
             data.settingId == settingId &&
             isValidId(data.settingId) &&
             data.telegramWebhookUrl is string &&
             data.telegramWebhookUrl.size() >= 12 &&
             data.telegramWebhookUrl.size() <= 512 &&
             data.telegramWebhookUrl.matches('^https://.+') &&
             data.updatedBy is string &&
             data.updatedBy == request.auth.uid &&
             data.updatedBy.size() <= 128 &&
             data.updatedByEmail is string &&
             data.updatedByEmail.size() >= 3 &&
             data.updatedByEmail.size() <= 256 &&
             data.updatedAt == request.time &&
             (!('lastValidationStatus' in data) || data.lastValidationStatus in ['green', 'yellow', 'red']) &&
             (!('lastValidatedAt' in data) || (data.lastValidatedAt is string && data.lastValidatedAt.size() <= 64)) &&
             (!('lastValidationMessage' in data) || (data.lastValidationMessage is string && data.lastValidationMessage.size() <= 500));
    }

    match /system_settings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSystemSetting(incoming(), settingId);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /courtroom_sessions/{id} {
      allow read: if true;
      allow write: if hasCourtRole() || isAdmin();
    }

    match /court_institutions/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isEmailVerified() && request.auth.uid == resource.data.adminUid);
      allow delete: if isAdmin();
    }

    match /court_users/{id} {
      allow read: if isEmailVerified() && (
        request.auth.uid == id || 
        isAdmin() || 
        (resource.data.institutionId is string && isCourtAdminOf(resource.data.institutionId))
      );
      
      allow create: if isAdmin() || (
        incoming().institutionId is string &&
        isCourtAdminOf(incoming().institutionId) &&
        incoming().role != 'superadmin' &&
        incoming().courtRole != 'superadmin'
      );
      
      allow update: if isAdmin() || (
        existing().institutionId is string &&
        isCourtAdminOf(existing().institutionId) &&
        incoming().institutionId == existing().institutionId &&
        incoming().role == existing().role &&
        incoming().courtRole == existing().courtRole
      );
      
      allow delete: if isAdmin();
    }

    match /court_access_requests/{id} {
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /test/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /verifications/{id} {
      allow read, write: if isAdmin();
    }

    match /cases/{id} {
      allow get, list: if hasCourtRole() && (
        resource.data.isPublic == true ||
        (resource.data.institutionId is string && belongsToInstitution(resource.data.institutionId))
      );
      allow create: if canEditCasesIn(incoming().institutionId) &&
                       incoming().institutionId is string && incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) &&
                       incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);

      match /activity_logs/{logId} {
        allow read: if isInstitutionStaff(resource.data.institutionId);
        allow create: if isInstitutionStaff(incoming().institutionId);
        allow update, delete: if false;
      }

      match /audio_recordings/{recId} {
        allow read: if isInstitutionStaff(resource.data.institutionId);
        allow create: if canEditCasesIn(incoming().institutionId);
        allow update: if canEditCasesIn(existing().institutionId) && incoming().institutionId == existing().institutionId;
        allow delete: if isCourtAdminOf(existing().institutionId);
      }

      match /physical_evidence/{evidenceId} {
        allow read: if isInstitutionStaff(resource.data.institutionId);
        allow create, update: if canEditCasesIn(incoming().institutionId);
        allow delete: if isCourtAdminOf(existing().institutionId);
      }

      match /witness_statements/{stmtId} {
        allow read: if isInstitutionStaff(resource.data.institutionId);
        allow create: if canEditCasesIn(incoming().institutionId);
        allow update: if canEditCasesIn(existing().institutionId) && incoming().institutionId == existing().institutionId;
        allow delete: if isCourtAdminOf(existing().institutionId);
      }

      match /courtroom_layout/{layoutId} {
        allow read: if isInstitutionStaff(resource.data.institutionId);
        allow create, update: if canEditCasesIn(incoming().institutionId);
        allow delete: if isCourtAdminOf(existing().institutionId);
      }
    }

    match /witness_statements/{stmtId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) && incoming().institutionId is string && incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) && incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /court_audio_recordings/{recId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create: if canEditCasesIn(incoming().institutionId) && incoming().institutionId is string && incoming().institutionId.size() > 0;
      allow update: if canEditCasesIn(existing().institutionId) && incoming().institutionId == existing().institutionId;
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /admin_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /court_notifications/{id} {
      allow read: if isEmailVerified() && (resource.data.recipientUid == request.auth.uid || hasCourtRole());
      allow create: if isEmailVerified() && (incoming().recipientUid == request.auth.uid || hasCourtRole());
      allow update: if isEmailVerified() && (existing().recipientUid == request.auth.uid || hasCourtRole());
      allow delete: if isAdmin();
    }

    match /court_templates/{id} {
      allow read: if true;
      allow write: if hasCourtRole();
    }

    match /practice_cases/{caseId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || hasCourtRole());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || hasCourtRole());
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || hasCourtRole());
    }

    match /collaboration_invites/{id} {
      allow read: if isEmailVerified() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified() && (
        incoming().ownerId == request.auth.uid ||
        incoming().createdBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isEmailVerified() && (
        existing().ownerId == request.auth.uid ||
        existing().createdBy == request.auth.uid ||
        isAdmin()
      );
    }

    match /vector_feedback/{id} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /user_feedback/{id} {
      allow create: if true;
      allow read: if isNonAnonymous() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /court_branding/{institutionId} {
      allow read: if true;
      allow write: if isCourtAdminOf(institutionId);
    }

    match /court_staff_requests/{requestId} {
      allow read: if isInstitutionStaff(resource.data.institutionId) || (isEmailVerified() && request.auth.uid == resource.data.userId);
      allow create: if isEmailVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isCourtAdminOf(existing().institutionId);
    }

    match /court_personnel_mappings/{mappingId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow write: if isCourtAdminOf(existing().institutionId);
    }

    match /case_milestones/{milestoneId} {
      allow read: if isInstitutionStaff(resource.data.institutionId);
      allow create, update: if canEditCasesIn(incoming().institutionId);
      allow delete: if isCourtAdminOf(existing().institutionId);
    }

    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isCourtAdminOf(institutionId);
      
      match /courtDocuments/{docId} {
        allow read: if isInstitutionStaff(institutionId);
        allow create: if canEditCasesIn(institutionId) &&
                         hasValidOptionalDataUrl(incoming()) &&
                         incoming().get('institutionId', institutionId) == institutionId;
        allow update: if canEditCasesIn(institutionId) &&
                         hasValidOptionalDataUrl(incoming()) &&
                         incoming().get('institutionId', existing().get('institutionId', institutionId)) == existing().get('institutionId', institutionId) &&
                         incoming().get('institutionId', institutionId) == institutionId;
        allow delete: if isCourtAdminOf(institutionId);
      }

      match /auditLogs/{logId} {
        allow read: if isInstitutionStaff(institutionId);
        allow create: if isInstitutionStaff(institutionId);
        allow update, delete: if false;
      }
    }

    match /court_documents/{docId} {
      allow read: if resource.data.get('isPublic', false) == true ||
                     (resource.data.get('institutionId', '') is string &&
                      resource.data.get('institutionId', '').size() > 0 &&
                      isInstitutionStaff(resource.data.get('institutionId', '')));
      allow create: if incoming().get('institutionId', '') is string &&
                       incoming().get('institutionId', '').size() > 0 &&
                       incoming().get('institutionId', '').size() <= 128 &&
                       canEditCasesIn(incoming().get('institutionId', '')) &&
                       hasValidOptionalDataUrl(incoming());
      allow update: if existing().get('institutionId', '') is string &&
                       existing().get('institutionId', '').size() > 0 &&
                       canEditCasesIn(existing().get('institutionId', '')) &&
                       incoming().get('institutionId', '') == existing().get('institutionId', '') &&
                       hasValidOptionalDataUrl(incoming());
      allow delete: if existing().get('institutionId', '') is string &&
                       existing().get('institutionId', '').size() > 0 &&
                       isCourtAdminOf(existing().get('institutionId', ''));
    }

    function canSubmitGlossary() {
      return isEmailVerified() && !(effectiveCourtRole() in ['auditor', 'read_only', 'readonly', 'guest']);
    }

    match /legal_glossary/{termId} {
      allow get, list: if resource.data.get('status', '') == 'approved' || isLegalRepositoryManager();
      allow create, update: if isLegalRepositoryManager() &&
                               isValidId(termId) &&
                               incoming().termId == termId &&
                               incoming().status in ['approved', 'archived'] &&
                               incoming().version is number &&
                               incoming().version >= 1;
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow get, list: if get(/databases/$(database)/documents/legal_glossary/$(termId)).data.get('status', '') == 'approved' || isLegalRepositoryManager();
        allow create: if isLegalRepositoryManager() &&
                         isValidId(versionId) &&
                         incoming().termId == termId &&
                         incoming().version is number;
        allow update, delete: if false;
      }
    }

    match /glossary_submissions/{submissionId} {
      allow get, list: if isEmailVerified() && (
        resource.data.submittedBy == request.auth.uid ||
        isLegalRepositoryManager()
      );
      allow create: if canSubmitGlossary() &&
                       isValidId(submissionId) &&
                       incoming().submissionId == submissionId &&
                       incoming().submittedBy == request.auth.uid &&
                       incoming().status == 'pending' &&
                       !('reviewedBy' in incoming()) &&
                       !('reviewedAt' in incoming());
      allow update: if isLegalRepositoryManager() || (
        canSubmitGlossary() &&
        existing().submittedBy == request.auth.uid &&
        existing().status in ['pending', 'needs_changes'] &&
        incoming().submittedBy == existing().submittedBy &&
        incoming().status == 'pending' &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'reviewedBy', 'reviewedAt', 'reviewerNote', 'reason', 'submissionId', 'submittedBy', 'submittedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /glossary_audit_logs/{auditId} {
      allow get, list: if isLegalRepositoryManager();
      allow create: if isLegalRepositoryManager() &&
                       isValidId(auditId) &&
                       incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    function isGlobalTranslationReviewer() {
      return isEmailVerified() && (
        isAdmin() ||
        request.auth.token.get('legalContentManager', false) == true
      );
    }

    function isTranslationReviewerFor(data) {
      return isGlobalTranslationReviewer() || (
        isEmailVerified() &&
        hasInstitution() &&
        effectiveCourtRole() in ['court_admin', 'judge', 'legal_expert'] &&
        data.get('institutionId', '') != '' &&
        data.get('institutionId', '') == request.auth.token.get('institutionId', '')
      );
    }

    match /translation_records/{translationId} {
      allow get, list: if isEmailVerified() && (
        resource.data.get('ownerUid', '') == request.auth.uid ||
        isTranslationReviewerFor(resource.data)
      );
      allow write: if false;
    }

    match /translation_feedback/{feedbackId} {
      allow get, list: if isEmailVerified() && (
        resource.data.submittedBy == request.auth.uid ||
        isTranslationReviewerFor(resource.data)
      );
      allow write: if false;

      match /private_review/{reviewId} {
        allow get, list: if isTranslationReviewerFor(resource.data);
        allow write: if false;
      }
    }

    match /translation_feedback_rate_limits/{uid} {
      allow read, write: if false;
    }

    match /translation_feedback_audit_logs/{auditId} {
      allow get, list: if isTranslationReviewerFor(resource.data);
      allow write: if false;
    }

    function isValidSeeraAIAnalysis(data, analysisId) {
      return data.keys().hasAll(['analysisId', 'userId', 'mode', 'prompt', 'createdAt', 'timestamp']) &&
             data.keys().hasOnly([
               'analysisId', 'userId', 'mode', 'prompt', 'context',
               'openaiResponse', 'geminiResponse', 'synthesis',
               'telegramChatId', 'telegramDispatched', 'createdAt', 'timestamp'
             ]) &&
             data.analysisId == analysisId &&
             isValidId(data.analysisId) &&
             data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.mode in ['openai', 'gemini', 'dual'] &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 20000 &&
             (!('context' in data) || (data.context is string && data.context.size() <= 40000)) &&
             (!('openaiResponse' in data) || (data.openaiResponse is string && data.openaiResponse.size() <= 50000)) &&
             (!('geminiResponse' in data) || (data.geminiResponse is string && data.geminiResponse.size() <= 50000)) &&
             (!('synthesis' in data) || (data.synthesis is string && data.synthesis.size() <= 50000)) &&
             (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 64)) &&
             (!('telegramDispatched' in data) || data.telegramDispatched is bool) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.timestamp == request.time;
    }

    match /seeraai_analyses/{analysisId} {
      allow get: if isEmailVerified() && isValidId(analysisId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(analysisId) && isValidSeeraAIAnalysis(incoming(), analysisId);
      allow update: if false;
      allow delete: if isEmailVerified() && isValidId(analysisId) && (existing().userId == request.auth.uid || isAdmin());
    }

    function isValidPrecedentComment(data, commentId) {
      return data.keys().hasAll([
               'commentId', 'precedentId', 'fileNumber', 'authorUid', 'authorName',
               'authorRole', 'institutionId', 'institutionName', 'commentType',
               'visibility', 'content', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'commentId', 'precedentId', 'fileNumber', 'authorUid', 'authorName',
               'authorRole', 'institutionId', 'institutionName', 'commentType',
               'visibility', 'content', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.commentId == commentId &&
             isValidId(data.commentId) &&
             data.precedentId is string && data.precedentId.size() >= 1 && data.precedentId.size() <= 128 &&
             data.fileNumber is string && data.fileNumber.size() >= 1 && data.fileNumber.size() <= 64 &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
             data.authorRole is string && data.authorRole.size() >= 1 && data.authorRole.size() <= 64 &&
             isValidId(data.institutionId) &&
             data.institutionName is string && data.institutionName.size() >= 1 && data.institutionName.size() <= 200 &&
             data.commentType in ['private_note', 'legal_question'] &&
             data.visibility in ['institution_private', 'personal_private'] &&
             data.content is string && data.content.size() >= 2 && data.content.size() <= 4000 &&
             data.status in ['open', 'resolved'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /precedent_comments/{commentId} {
      allow get: if isEmailVerified() && isValidId(commentId) && (
        (existing().visibility == 'personal_private' && existing().authorUid == request.auth.uid && isInstitutionStaff(existing().institutionId)) ||
        (existing().visibility == 'institution_private' && isInstitutionStaff(existing().institutionId)) ||
        isAdmin()
      );
      allow list: if isEmailVerified() && (
        (existing().visibility == 'personal_private' && existing().authorUid == request.auth.uid && isInstitutionStaff(existing().institutionId)) ||
        (existing().visibility == 'institution_private' && isInstitutionStaff(existing().institutionId)) ||
        isAdmin()
      );
      allow create: if isEmailVerified() &&
        isValidId(commentId) &&
        isValidPrecedentComment(incoming(), commentId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().status == 'open' &&
        isInstitutionStaff(incoming().institutionId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isEmailVerified() &&
        isValidId(commentId) &&
        isValidPrecedentComment(incoming(), commentId) &&
        existing().authorUid == request.auth.uid &&
        isInstitutionStaff(existing().institutionId) &&
        incoming().commentId == existing().commentId &&
        incoming().precedentId == existing().precedentId &&
        incoming().fileNumber == existing().fileNumber &&
        incoming().authorUid == existing().authorUid &&
        incoming().authorName == existing().authorName &&
        incoming().authorRole == existing().authorRole &&
        incoming().institutionId == existing().institutionId &&
        incoming().institutionName == existing().institutionName &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'commentType', 'visibility', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isEmailVerified() && isValidId(commentId) && (
        (existing().authorUid == request.auth.uid && isInstitutionStaff(existing().institutionId)) ||
        isCourtAdminOf(existing().institutionId) ||
        isAdmin()
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
